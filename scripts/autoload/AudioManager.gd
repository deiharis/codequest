extends Node
## Every sound in the game is played through here.
##
## An autoload rather than a player per scene, for one reason: a victory sting
## has to outlive the scene that triggered it. SceneRouter frees the battle
## while the banner is still on screen, and a player parented to that battle
## would be freed mid-note.
##
## A fixed pool of voices, round-robin. No pool means overlapping sounds cut
## each other off; an unbounded one means a stuck sound leaks a node forever.
## Ten is more simultaneous effects than this game ever asks for.
##
## Sounds are generated by tools/make_sfx.py, not downloaded — ADR-028.

const SFX_DIR := "res://assets/audio/sfx/"
const VOICES := 10

## Settings live in their own file, not in the save game. Muting is a
## preference, not progress: it should survive `GameState.reset()`, and starting
## a new campaign should not turn the sound back on.
const SETTINGS_PATH := "user://settings.cfg"

const MUSIC_DIR := "res://assets/audio/music/"
## Two players, not one. A crossfade needs the old track still sounding while
## the new one comes up; a single player can only cut.
const MUSIC_FADE := 1.2

## Per-button overrides, and the flag that stops a button being hooked twice.
## Metadata rather than a Dictionary keyed by node: metadata dies with the node,
## a Dictionary would hold a reference to every button the game has ever built.
const META_HOOKED := "_sfx_hooked"
const META_HOVER := "hover_sfx"
const META_CLICK := "click_sfx"

## Master trim for every effect. Negative because the sounds are normalised to
## -1.4dB peak on disk, which is correct for a file and too loud for a game.
var sfx_volume_db: float = -6.0:
	set(value):
		sfx_volume_db = value
		for p in _players:
			p.volume_db = value
		_save_settings()

var muted: bool = false:
	set(value):
		muted = value
		if muted:
			stop_all()      # cut what is already in the air, do not wait it out
		_apply_music_volume()
		_save_settings()

## Music sits below the effects on purpose: it is the floor of the mix, and a
## bed that competes with a sword hit is a bed nobody wanted.
##
## -6, not -13. Measured in the band a laptop reproduces, the loops sit around
## -21dB and the effects around -15; -13 on top of that would have put the music
## 13dB under, which is not "underneath" but "inaudible".
var music_volume_db: float = -6.0:
	set(value):
		music_volume_db = value
		_apply_music_volume()
		_save_settings()

## What is playing now, so asking for the same track twice does not restart it.
## That is what lets the Space Map's loop run unbroken through the rocket
## flight and back again.
var current_music: StringName = &""

## False until the settings file has been read, so loading it does not trigger
## a save of what was just loaded.
var _settings_loaded: bool = false

var _players: Array[AudioStreamPlayer] = []
var _music: Array[AudioStreamPlayer] = []
var _music_slot: int = 0
var _music_fade: Tween
var _next: int = 0
var _cache: Dictionary = {}


func _ready() -> void:
	# Sound keeps playing through a pause menu or a hitstop.
	process_mode = Node.PROCESS_MODE_ALWAYS
	for i in VOICES:
		var p := AudioStreamPlayer.new()
		p.name = "Voice%d" % i
		p.volume_db = sfx_volume_db
		add_child(p)
		_players.append(p)

	for i in 2:
		var m := AudioStreamPlayer.new()
		m.name = "Music%d" % i
		m.volume_db = -80.0
		add_child(m)
		_music.append(m)

	_load_settings()

	# Every Button in the game gets its click and hover from here.
	#
	# One connection to the tree rather than two lines in every scene: the
	# Space Map builds its planets in a loop, the lesson rebuilds its card on
	# every beat, and the Archive builds eight rows — all of which would have to
	# remember to do it, and one of which eventually would not. A button that
	# exists is a button that is wired.
	get_tree().node_added.connect(_on_node_added)


## Play a sound by file name, without the extension: play(&"sword_hit").
##
## `pitch_jitter` varies the pitch slightly on each call. Two identical samples
## back to back read as a machine; the same sample ±5% reads as two hits. Pass
## 0.0 for anything musical, where a wrong pitch is a wrong note.
##
## `volume_db` is a per-call trim on top of the master.
func play(sound: StringName, pitch_jitter: float = 0.05,
		volume_db: float = 0.0) -> void:
	if muted:
		return
	var stream := _load(sound)
	if stream == null:
		return

	var p := _take_voice()
	p.stream = stream
	p.volume_db = sfx_volume_db + volume_db
	p.pitch_scale = 1.0 + randf_range(-pitch_jitter, pitch_jitter)
	p.play()


## The next voice in the rotation. If everything is busy this steals the oldest,
## which is the right answer — dropping the newest sound means the hit the
## player just caused is the one that goes silent.
func _take_voice() -> AudioStreamPlayer:
	for i in VOICES:
		var p := _players[(_next + i) % VOICES]
		if not p.playing:
			_next = (_next + i + 1) % VOICES
			return p
	var stolen := _players[_next]
	_next = (_next + 1) % VOICES
	return stolen


## Missing sounds are a warning, once, and then silence. A game that crashes
## because an effect is absent is worse than a quiet one.
func _load(sound: StringName) -> AudioStream:
	if _cache.has(sound):
		return _cache[sound]

	var path := SFX_DIR + str(sound) + ".wav"
	var stream: AudioStream = null
	if ResourceLoader.exists(path):
		stream = load(path)
	else:
		push_warning("AudioManager: no sound at %s" % path)
	_cache[sound] = stream
	return stream


# --------------------------------------------------------------------------
# Global UI wiring
# --------------------------------------------------------------------------

func _on_node_added(node: Node) -> void:
	if node is Button:
		hook_button(node)


## Idempotent, because a node can re-enter the tree. Connecting a signal twice
## would play the sound twice, which is audible as a flam rather than a click.
##
## A button can override either sound by carrying metadata:
##
##     button.set_meta("hover_sfx", &"planet_hover")
##
## which is how the Space Map's planets get a chime instead of the default tick
## without the Space Map having to know this system exists beyond one line.
func hook_button(b: Button) -> void:
	if b.has_meta(META_HOOKED):
		return
	b.set_meta(META_HOOKED, true)
	b.pressed.connect(_button_pressed.bind(b))
	b.mouse_entered.connect(_button_hover.bind(b))


func _button_pressed(b: Button) -> void:
	var sound: StringName = b.get_meta(META_CLICK, &"ui_click")
	play(sound, 0.04)


## Quieter than the click on purpose. A hover is not a decision, and the mouse
## crosses a lot of buttons on the way to the one it wants.
##
## Silent while disabled. Godot keeps emitting `mouse_entered` on a disabled
## Button — only `pressed` stops — so without this guard the question panel goes
## on whispering under the cursor after the answer is locked in, and so do the
## Archive's empty rows and the lesson's Continue button while a check beat
## holds it shut. A hover sound is a promise that the thing can be pressed.
func _button_hover(b: Button) -> void:
	if b.disabled:
		return
	var sound: StringName = b.get_meta(META_HOVER, &"ui_hover")
	play(sound, 0.07, -7.0)


# --------------------------------------------------------------------------
# Music
# --------------------------------------------------------------------------

## Crossfade to a track by file name, without the extension.
##
## Asking for the track that is already playing does nothing at all — scenes
## call this in `_ready`, so the Space Map, the rocket flight and the Space Map
## again would otherwise restart the same loop three times in ten seconds.
func play_music(track: StringName, fade: float = MUSIC_FADE) -> void:
	if track == current_music:
		return
	var stream := _load_music(track)
	if stream == null:
		return

	current_music = track
	var outgoing := _music[_music_slot]
	_music_slot = 1 - _music_slot
	var incoming := _music[_music_slot]

	incoming.stream = stream
	incoming.volume_db = -80.0
	incoming.play()

	if _music_fade and _music_fade.is_valid():
		_music_fade.kill()
	_music_fade = create_tween().set_parallel()
	_music_fade.tween_property(incoming, "volume_db", _music_target_db(), fade)
	if outgoing.playing:
		_music_fade.tween_property(outgoing, "volume_db", -80.0, fade)
		# Stopped only once it is silent, or the next track inherits a player
		# that is still audible and the fade happens twice.
		_music_fade.chain().tween_callback(outgoing.stop)


func stop_music(fade: float = MUSIC_FADE) -> void:
	current_music = &""
	if _music_fade and _music_fade.is_valid():
		_music_fade.kill()
	_music_fade = create_tween().set_parallel()
	for m in _music:
		if m.playing:
			_music_fade.tween_property(m, "volume_db", -80.0, fade)
	_music_fade.chain().tween_callback(func() -> void:
		for m in _music:
			m.stop())


func _music_target_db() -> float:
	return -80.0 if muted else music_volume_db


## Mute and volume changes reach whichever player is currently up, without
## disturbing a crossfade in progress — that tween owns the other one.
func _apply_music_volume() -> void:
	if _music.is_empty():
		return
	if _music_fade and _music_fade.is_valid() and _music_fade.is_running():
		return
	for i in _music.size():
		if _music[i].playing:
			_music[i].volume_db = _music_target_db() if i == _music_slot else -80.0


## Loops are loops. Godot imports an Ogg stream with looping off by default, and
## a background track that plays once and stops is worse than silence because
## the player notices the moment it ends.
func _load_music(track: StringName) -> AudioStream:
	var path := MUSIC_DIR + str(track) + ".ogg"
	if not ResourceLoader.exists(path):
		push_warning("AudioManager: no music at %s" % path)
		return null
	var stream: AudioStream = load(path)
	if stream is AudioStreamOggVorbis:
		stream.loop = true
	return stream


# --------------------------------------------------------------------------
# Settings
# --------------------------------------------------------------------------

func _load_settings() -> void:
	var cfg := ConfigFile.new()
	if cfg.load(SETTINGS_PATH) != OK:
		_settings_loaded = true
		return
	# These assignments run through the setters, which call _save_settings().
	# `_settings_loaded` is still false here, so that save is a no-op — the
	# file is not rewritten with what was just read out of it.
	muted = bool(cfg.get_value("audio", "muted", false))
	sfx_volume_db = float(cfg.get_value("audio", "sfx_volume_db", sfx_volume_db))
	music_volume_db = float(cfg.get_value("audio", "music_volume_db", music_volume_db))
	_settings_loaded = true


func _save_settings() -> void:
	if not _settings_loaded:
		return
	var cfg := ConfigFile.new()
	cfg.set_value("audio", "muted", muted)
	cfg.set_value("audio", "sfx_volume_db", sfx_volume_db)
	cfg.set_value("audio", "music_volume_db", music_volume_db)
	cfg.save(SETTINGS_PATH)


func stop_all() -> void:
	for p in _players:
		p.stop()
